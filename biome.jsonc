{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Ultracite's rules, as a check only: the formatter and the assists are off, so nothing here
  // rewrites a file. Every rule is on except the ones listed under "off". Turn them back on one at
  // a time, each in its own change.
  "extends": ["ultracite/biome/core"],
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "json": { "formatter": { "enabled": false } },
  "css": { "formatter": { "enabled": false } },
  "html": { "formatter": { "enabled": false } },
  "linter": {
    "rules": {
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "off",
        "useSortedClasses": "off"
      },
      "a11y": {
        "noNoninteractiveTabindex": "off",
        "noSvgWithoutTitle": "off",
        "useAriaPropsSupportedByRole": "off",
        "useSemanticElements": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noForEach": "off",
        "noUselessUndefined": "off",
        "noVoid": "off",
        "useOptionalChain": "off",
        "useSimplifiedLogicExpression": "off"
      },
      "correctness": {
        "noUndeclaredDependencies": "off",
        "useExhaustiveDependencies": "off"
      },
      "performance": {
        "noAccumulatingSpread": "off",
        "noAwaitInLoops": "off",
        "noBarrelFile": "off",
        "noImgElement": "off",
        "noJsxPropsBind": "off",
        "useTopLevelRegex": "off"
      },
      "style": {
        "noDescendingSpecificity": "off",
        "noIncrementDecrement": "off",
        "noNegationElse": "off",
        "noNestedTernary": "off",
        "noNonNullAssertion": "off",
        "noUnusedTemplateLiteral": "off",
        "useAtIndex": "off",
        "useBlockStatements": "off",
        "useConsistentBuiltinInstantiation": "off",
        "useConsistentMethodSignatures": "off",
        "useConsistentTypeDefinitions": "off",
        "useDefaultSwitchClause": "off",
        "useDestructuring": "off",
        "useErrorCause": "off",
        "useFilenamingConvention": "off",
        "useForOf": "off",
        "useImportType": "off",
        "useNumberNamespace": "off",
        "useNumericSeparators": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "off",
        "noBitwiseOperators": "off",
        "noEmptyBlockStatements": "off",
        "noEvolvingTypes": "off",
        "noImplicitAnyLet": "off",
        "noLeakedRender": "off",
        "noMisplacedAssertion": "off",
        "noNestedPromises": "off",
        "noReturnAssign": "off",
        "noShadow": "off",
        "noUnnecessaryConditions": "off",
        "useAwait": "off",
        "useIterableCallbackReturn": "off",
        "useStaticResponseMethods": "off"
      }
    }
  }
}
