{
  "name": "orientim-guard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cargo build-sbf --manifest-path programs/guard/Cargo.toml && cargo build-sbf --manifest-path tests/guard/attacker/Cargo.toml",
    "fuzz": "node tests/guard/fuzz.ts",
    "jupiter": "node tests/guard/jupiter.ts",
    "lint": "ultracite check",
    "test": "node tests/guard/run.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@solana-program/compute-budget": "^0.18.1",
    "@solana-program/system": "^0.14.1",
    "@solana-program/token": "^0.16.1",
    "@solana/kit": "^8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.1",
    "litesvm": "^1.4.1",
    "typescript": "^7.0.2",
    "ultracite": "8.0.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
