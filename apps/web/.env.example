# Copy to .env.local and fill in.

# --- Fixed at build time (compiled into the build; changing them needs a new build) ------------
# Wallet that receives the Orientim fee. Leave empty for test mode (no fee). When set, fund it with a
# little SOL first: a swap whose fee cannot be collected is refused, never built free.
# Give it a little SOL and open its USDC and USDT accounts: a swap pays in SOL, USDC or USDT when
# either side is one of them, in the input token when the treasury has that token's account, and
# otherwise in SOL from the wallet. Orientim never makes the user pay the treasury's rent.
NEXT_PUBLIC_ORIENTIM_TREASURY=
# Fee in basis points (25 = 0.25%). The site and the shipped skill refuse more than 30.
NEXT_PUBLIC_ORIENTIM_FEE_BPS=25
# v1 transactions for an agent that asks for them (prepare with version 1). Off until one Orientim
# v1 swap has landed on mainnet; until then every swap is v0.
NEXT_PUBLIC_ORIENTIM_ENABLE_V1=
# Jupiter beta fast routing for agent prepare, off by default; each bot must also request routingMode=fast.
ORIENTIM_ENABLE_FAST_ROUTING=

# --- Server only (never sent to the browser) ------------------------------------------------------
# Solana RPC (a paid provider is recommended; the public one is rate limited).
# Helius is the provider we run on; the public endpoint only suits local work.
RPC_URL=https://api.mainnet-beta.solana.com
# A backup RPC from another provider (Alchemy), asked only when RPC_URL does not answer, is
# rate-limited or fails (5xx), for the agent API. A send takes the backup's answer only
# when it is a success. Empty: RPC_URL alone.
RPC_URL_FALLBACK=

# Jupiter API key (free, https://developers.jup.ag/portal). Required for any real use: Jupiter's API
# asks for a key on every endpoint, and without one it answers a request or two before refusing, so
# quotes fail as "busy". /api/health says whether Jupiter answers with it (it never names the key).
JUPITER_API_KEY=

# The one header your hosting's ingress overwrites with the real client address (used for rate
# limits). Vercel: x-vercel-forwarded-for (default). Behind Cloudflare: cf-connecting-ip.
# Also set a rate-limit rule in the hosting firewall: it is what holds under a flood.
ORIENTIM_CLIENT_IP_HEADER=x-vercel-forwarded-for

# Redis (Upstash, over REST) that every instance shares: one message per one-time key, one swap in
# flight per output account, the rate limits and the RPC failover's notes. Required in production:
# without it finalize refuses every swap (unless ORIENTIM_TEST_MODE=1). Keep its eviction off. On
# Vercel, the Upstash integration sets KV_REST_API_URL and KV_REST_API_TOKEN instead; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Kill switch: set to 1 to refuse new swaps. Enforced by the server (build and send), not only the UI.
ORIENTIM_DISABLED=

# DEXes that charge the taker persistent rent.
ORIENTIM_EXCLUDE_DEXES=HumidiFi

# F_max: maximum network fee per swap, in lamports (0.0005 SOL). Capped at 1,000,000 by the verifier.
# Lower means cheaper swaps that expire more often when the network is busy.
ORIENTIM_MAX_NETWORK_FEE_LAMPORTS=500000

# --- Agent API (AGENT-API.md): off unless both are set -------------------------------------------
# 32 random bytes, base64: seals tickets and derives each one-time key. node tools/agent-key.ts --secret
ORIENTIM_API_SECRET=
# While rotating: the previous secret, for the tickets it sealed. A ticket has no expiry of its own:
# it ends with its transaction's last valid block height (about a minute) and the one-time key's
# 10-minute record; keep the previous secret that long at least.
ORIENTIM_API_SECRET_PREVIOUS=
# id:sha256-of-key, comma-separated. node tools/agent-key.ts <id> prints a key and its entry.
ORIENTIM_API_KEYS=
# Fee for API swaps in bps; NEXT_PUBLIC_ORIENTIM_FEE_BPS when empty.
ORIENTIM_API_FEE_BPS=
# The oldest skill version prepare still serves (e.g. 1.0.0), for a change that old copies of the
# skill cannot follow; agents that send an older x-orientim-skill are asked to update. Empty: all.
ORIENTIM_MIN_SKILL_VERSION=
# Requests per minute (defaults in parentheses). Add a firewall rule too.
# Prepare per API key (60), finalize per key (30), prepare per client address (120), prepare in all (300).
ORIENTIM_API_PER_MINUTE=
ORIENTIM_API_FINALIZE_PER_MINUTE=
ORIENTIM_API_IP_PER_MINUTE=
ORIENTIM_API_TOTAL_PER_MINUTE=
# Self-serve keys (AGENT-API.md, "API access"): a wallet signs a message on /developers#access and gets a
# key bound to it. 32 random bytes, base64, not the ORIENTIM_API_SECRET: node tools/agent-key.ts
# --key-secret. Anything else (a passphrase, hex) leaves self-serve keys off. Empty: none.
ORIENTIM_KEY_SECRET=
# The site's own address, the only one the key message names (https://orientim.com). Set it wherever
# self-serve keys are on; empty means the host each request names, as on a machine of your own.
ORIENTIM_PUBLIC_ORIGIN=
# While rotating: the previous key secret, whose keys still open until it is removed.
ORIENTIM_KEY_SECRET_PREVIOUS=
# Self-serve keys refused, comma-separated: <wallet> for all its keys, <wallet>@<unix seconds> for those
# issued until then (its owner can then sign again for a new one).
ORIENTIM_API_REVOKED=
# What a wallet must hold to get a key, in lamports (default 10000000: 0.01 SOL; never below 1000000).
ORIENTIM_KEY_MIN_LAMPORTS=
# How many keys are issued in an hour, to every address together (default 300; per instance without Redis).
ORIENTIM_KEY_MAX_PER_HOUR=
# A private Vercel Blob store (Storage, Blob, access Private) keeps each wallet's signed acceptance of
# the Terms; with it set, no key is given unrecorded. Vercel sets it when the store is connected.
BLOB_READ_WRITE_TOKEN=
